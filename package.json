{
  "name": "@xpell/agent-channels",
  "version": "2.0.7",
  "publishConfig": {
    "access": "public"
  },
  "description": "Official provider Channel adapters for @xpell/agent.",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./telegram": {
      "types": "./dist/telegram/index.d.ts",
      "import": "./dist/telegram/index.js"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp/index.d.ts",
      "import": "./dist/whatsapp/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "publish-alpha-next": "pnpm version prerelease --preid=alpha && pnpm publish --tag alpha"
  },
  "xpell": {
    "_tests": [
      {
        "_id": "xpell-agent-channels.script.test",
        "_title": "@xpell/agent-channels package acceptance test",
        "_owner": "@xpell/agent-channels",
        "_suite": "xpell-agent-channels.package",
        "_scope": "package",
        "_runtime": "node",
        "_description": "Builds the package and verifies Telegram webhook ingress, XAgent execution, and outbound Bot API delivery.",
        "_profiles": ["xpell-agent-channels.package"],
        "_tags": ["package", "telegram", "channel", "webhook"],
        "_entry": {
          "_type": "script",
          "_script": "test"
        }
      },
      {
        "_id": "xpell-agent-channels.package.check",
        "_title": "@xpell/agent-channels package metadata check",
        "_owner": "@xpell/agent-channels",
        "_suite": "xpell-agent-channels.package",
        "_scope": "package",
        "_runtime": "node",
        "_description": "Verifies package metadata and declared local entries without publishing or network checks.",
        "_profiles": ["xpell-agent-channels.package"],
        "_tags": ["package-check"],
        "_entry": {
          "_type": "package-check",
          "_check": "package"
        }
      }
    ],
    "_test_profiles": [
      {
        "_id": "xpell-agent-channels.package",
        "_title": "@xpell/agent-channels package verification",
        "_includes": ["xpell-agent-channels.*"],
        "_tags": ["package", "telegram"]
      }
    ]
  },
  "keywords": ["xpell", "agent", "channel", "telegram", "whatsapp"],
  "author": "Tamir Fridman <fridman.tamir@gmail.com> (https://github.com/fridman-tamir)",
  "license": "MIT",
  "peerDependencies": {
    "@xpell/agent": "workspace:*",
    "@xpell/node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@xpell/agent": "workspace:*",
    "@xpell/node": "workspace:*",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
